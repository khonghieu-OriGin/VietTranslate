# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# MongoDB (for Vercel deployment fallback)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/viettranslate_db

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///instance/database.db

# Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# Thanh toán thật bằng chuyển khoản VietQR (đối soát qua webhook SePay)
# sandbox = nút thanh toán giả để thử; live = chỉ nhận tiền thật, không có nút giả
PAYMENT_MODE=sandbox
BANK_CODE=MBBank
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
# Khóa tự đặt khi tạo webhook trên SePay (kiểu xác thực "API Key"), webhook URL: https://<domain>/api/webhooks/sepay
SEPAY_API_KEY=
CRON_SECRET=
